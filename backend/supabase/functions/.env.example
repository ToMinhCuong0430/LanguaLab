# Biến môi trường cho Edge Functions khi chạy local:
#   cp functions/.env.example functions/.env  (file .env đã được .gitignore)
#   npx supabase functions serve --workdir backend --env-file backend/supabase/functions/.env
# Trên Supabase Cloud: npx supabase secrets set GEMINI_API_KEY=... --workdir backend

# gemini | anthropic | mock (chấm giả lập để thử giao diện, KHÔNG phải điểm thật)
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# gemini-3.5-flash có hạn mức ở gói miễn phí; model Pro (vd. gemini-pro-latest) cần bật thanh toán
GEMINI_MODEL=gemini-3.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
AI_SCORING_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_SCORING_EFFORT=high

# Số lượt chấm AI tối đa mỗi người dùng trong 24 giờ
AI_SCORING_DAILY_LIMIT=20
# Chỉ dùng với AI_PROVIDER=mock: giả lập độ trễ (ms) để xem màn hình loading
AI_MOCK_DELAY_MS=0
