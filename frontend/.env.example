# Supabase Public Configuration for Langua
# Tuyệt đối KHÔNG đưa service_role key vào đây! Chỉ dùng URL và anon/publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-publishable-or-anon-key

# Chế độ dữ liệu dự phòng (Mock Fallback khi chưa kết nối database hoặc mạng offline)
NUXT_PUBLIC_USE_MOCK=false
